{
  "name": "angular-dashboard-sandbox",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "test:coverage": "ng test --code-coverage",
    "lint": "ng lint",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug"
  },
  "packageManager": "pnpm@9.0.0",
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "tar": "^7.5.19",
      "piscina": "^5.3.2",
      "proxy-addr": "^2.0.8",
      "glob": "^10.5.0",
      "@isaacs/brace-expansion": "^5.0.1",
      "flatted": "^3.4.2",
      "tmp": "^0.2.6",
      "source-map-js": "^1.2.2",
      "postcss": "8.5.31",
      "browserslist": "^4.28.7",
      "fast-uri": "^3.1.8",
      "immutable": "^5.1.8",
      "engine.io": "^6.6.10",
      "socket.io-parser": "^4.2.7",
      "ip-address": "^10.7.1",
      "lodash": "^4.18.1",
      "qs": "^6.16.1",
      "follow-redirects": "^1.16.0",
      "@babel/core": "^7.29.6",
      "picomatch@2": "2.3.2",
      "minimatch@3": "3.1.5",
      "minimatch@9": "9.0.9",
      "nanoid@3": "3.3.20",
      "ws@8": "8.22.0",
      "body-parser@1": "1.20.8",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "path-to-regexp@8": "8.4.2",
      "ajv@8": "8.20.0"
    }
  },
  "dependencies": {
    "@angular/animations": "^20.3.34",
    "@angular/common": "^20.3.34",
    "@angular/compiler": "^20.3.34",
    "@angular/core": "^20.3.34",
    "@angular/forms": "^20.3.34",
    "@angular/platform-browser": "^20.3.34",
    "@angular/router": "^20.3.34",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.40",
    "@angular/cli": "^20.3.40",
    "@angular/compiler-cli": "^20.3.34",
    "@playwright/test": "^1.56.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  }
}
